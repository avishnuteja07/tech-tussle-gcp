# ==============================================================================
# Environment Configuration for GMOCS (MITS Examination Platform)
# ==============================================================================

# Node Environment & Network
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
COOKIE_SECURE=false

# PostgreSQL Connection String (Dedicated application user)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://mits_admin:ChangeMeSecurePassword123@127.0.0.1:5432/mits_login

# Optional: Initial administrator bootstrap credentials
# If set, automatically creates or updates the administrator account on startup.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Server-side PINs required to start Levels 2 and 3. Set privately, then restart.
LEVEL_2_PIN=
LEVEL_3_PIN=

# Level 3 Code Execution Engine Settings
# Runner priority: "local,remote" (fast local compilation with remote fallback) or "remote,local"
RUNNER_PREFERENCE=local,remote

# Optional: Route specific heavy runtimes (e.g. java,csharp) directly to remote Judge0
PREFER_REMOTE_LANGUAGES=

# Optional: Completely disable local execution for specified languages and force remote Judge0
DISABLE_LOCAL_LANGUAGES=

# Remote Judge0 provider settings
JUDGE0_URL=https://ce.judge0.com
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_HEADER=X-Auth-Token

# Optional: RapidAPI key if using RapidAPI Judge0
RAPIDAPI_KEY=

# Additional comma-separated fallback Judge0 URLs if primary fails
JUDGE0_FALLBACK_URLS=

# Override language IDs if your Judge0 installation uses a different language catalog.
JUDGE0_LANGUAGE_IDS={"c":50,"cpp":54,"csharp":51,"java":62,"javascript":63,"python":71}
